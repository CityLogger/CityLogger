{
  "name": "citylogger",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:mobile": "vite build --config vite.mobile.config.ts",
    "mobile:sync": "pnpm build:mobile && cap sync ios",
    "mobile:open": "cap open ios",
    "start": "vinext start",
    "review:seed": "node scripts/seed-review-account.mjs",
    "review:verify": "node scripts/verify-review-account.mjs",
    "release:check": "node scripts/check-release-readiness.mjs",
    "typecheck": "tsc --noEmit",
